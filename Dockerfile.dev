# Stage 1: Hugo build
FROM node:slim AS builder

ENV HUGO_VERSION=0.138.0
ENV HUGO_CACHEDIR=/tmp/hugo_cache
ENV GO_VERSION=1.21.3
ENV DART_SASS_VERSION=1.97.3

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) go_arch='amd64'; hugo_arch='amd64'; sass_arch='x64' ;; \
        arm64) go_arch='arm64'; hugo_arch='arm64'; sass_arch='arm64' ;; \
        *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -L -o /tmp/go.tar.gz "https://dl.google.com/go/go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    tar -xzf /tmp/go.tar.gz -C /usr/local; \
    rm /tmp/go.tar.gz; \
    ln -sf /usr/local/go/bin/go /usr/bin/go; \
    curl -L -o /tmp/hugo.tar.gz "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${hugo_arch}.tar.gz"; \
    tar -xzf /tmp/hugo.tar.gz -C /usr/local/bin hugo; \
    chmod +x /usr/local/bin/hugo; \
    rm /tmp/hugo.tar.gz; \
    curl -L -o /tmp/dart-sass.tar.gz "https://github.com/sass/dart-sass/releases/download/${DART_SASS_VERSION}/dart-sass-${DART_SASS_VERSION}-linux-${sass_arch}.tar.gz"; \
    tar -xzf /tmp/dart-sass.tar.gz -C /usr/local/bin --strip-components=1; \
    rm /tmp/dart-sass.tar.gz

WORKDIR /app

# Install go deps
COPY go.mod go.sum ./
RUN go mod download

# Install hugo deps
COPY config/ config/
RUN hugo mod graph

# Install node deps
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the site
COPY . .
